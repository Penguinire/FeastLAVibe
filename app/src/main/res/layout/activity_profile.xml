<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_myplaces"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/pink_primary"
                app:strokeWidth="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:id="@+id/tv_profile_name"
                android:text="SHEBA SHXT"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:id="@+id/tv_profile_meta"
                android:text="Pretoria, CBD · Member since 2023"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatBox">
                    <TextView android:id="@+id/tv_reviews_count" style="@style/StatNumber" android:text="0" />
                    <TextView style="@style/StatLabel" android:text="Reviews" />
                </LinearLayout>

                <LinearLayout style="@style/StatBox" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tv_favourites_count" style="@style/StatNumber" android:text="0" />
                    <TextView style="@style/StatLabel" android:text="Favourites" />
                </LinearLayout>

                <LinearLayout style="@style/StatBox" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tv_visited_count" style="@style/StatNumber" android:text="0" />
                    <TextView style="@style/StatLabel" android:text="Visited" />
                </LinearLayout>
            </LinearLayout>

            <!-- Menu items -->
            <include android:id="@+id/menu_reviews" layout="@layout/item_profile_menu"
                android:layout_marginTop="32dp" />
            <include android:id="@+id/menu_settings" layout="@layout/item_profile_menu" />
            <include android:id="@+id/menu_help" layout="@layout/item_profile_menu" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:id="@+id/tv_log_out"
                android:text="Log Out"
                android:textColor="@color/pink_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>